{
  "manifest_version": 3,
  "name": "Quick Select Tools",
  "version": "0.1.0",
  "description": "Shows a small action bubble on text selection to count characters, translate to Japanese, or search Google.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Quick Select Tools",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": false,
      "run_at": "document_idle"
    }
  ]
}
